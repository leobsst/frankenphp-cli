APP_ENV=dev
UID=
GID=
MARIADB_ROOT_PASSWORD=

# Default project path (used if not specified in start command)
DEFAULT_PROJECT_PATH=

# Default PHP version for new domains (8.2, 8.3, 8.4, 8.5)
# Used when --php is not specified in start/add-host commands
# PHP 8.2 is deprecated: still supported, but a warning is shown when used
DEFAULT_PHP_VERSION=8.3

# Storage paths (relative to data directory, or absolute paths)
# Leave empty for defaults: ./caddy, ./database
CADDY_DIR=
DATABASE_DIR=

# Set to "true" to expose services to the network.
# By default, services are bound to localhost only (127.0.0.1).
EXPOSE_SERVICES=false

# Service ports (host:container format when EXPOSE_SERVICES=false uses 127.0.0.1 prefix)
DB_PORT=3306
# phpMyAdmin (dev only), also served at https://localhost when MariaDB or MySQL
# is enabled. It connects to both when both are enabled (MariaDB by default).
PMA_PORT=8080

# Set to "true" to run a Redis cache container (disabled by default)
REDIS_ENABLED=false
REDIS_PORT=6379

# Set to "true" to run a Soketi WebSocket server (Pusher protocol, disabled by
# default). Browsers connect to wss://ws.frankenmanager.test (TLS handled by the
# reverse proxy), PHP apps reach its API at 127.0.0.1:SOKETI_PORT.
SOKETI_ENABLED=false
SOKETI_PORT=6001
# Default app credentials. Left empty, they are generated on start and saved here.
SOKETI_DEFAULT_APP_ID=
SOKETI_DEFAULT_APP_KEY=
SOKETI_DEFAULT_APP_SECRET=

# Web server ports (FrankenPHP/Caddy)
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# Set to "true" to run a DNS server that resolves every registered domain to
# this machine, so other devices on the LAN reach them by using it as their
# DNS server (no hosts file to edit on each device). Other queries are
# forwarded to DNS_UPSTREAM.
DNS_SERVER=false
# IP the domains resolve to. Leave empty to auto-detect this machine's LAN IP
# and follow its changes (e.g. Wi-Fi to Ethernet) while the server runs.
DNS_IP=
# Address the DNS server listens on. Leave empty to listen on every interface
# (0.0.0.0), so it keeps working when switching from Wi-Fi to Ethernet. Set it
# if port 53 is already taken on some address (e.g. systemd-resolved on Linux).
DNS_LISTEN_IP=
DNS_PORT=53
# Space-separated resolvers for non-local queries (e.g. your router's IP)
DNS_UPSTREAM=1.1.1.1 8.8.8.8

# Base Linux distribution of the PHP images: "alpine" (default, smaller) or
# "trixie" (Debian, glibc). Changing it rebuilds the images on next start.
PHP_IMAGE_DISTRO=alpine

# Set to "true" to install pdftk in the PHP image (adds a Java runtime, ~200 MB)
INSTALL_PDFTK=false

# Extra Linux packages to install in the PHP image, on top of the built-in
# ones, space-separated. Applies to every PHP version. Use EXTRA_APK_PACKAGES
# with PHP_IMAGE_DISTRO=alpine and EXTRA_APT_PACKAGES with trixie, as package
# names differ between the two.
# Example: EXTRA_APK_PACKAGES=htop vim
EXTRA_APK_PACKAGES=
EXTRA_APT_PACKAGES=

# Extra Linux packages for one specific PHP version only (merged with the
# variable above). Suffix is the PHP version without the dot.
# EXTRA_APK_PACKAGES_84=
# EXTRA_APT_PACKAGES_82=
# EXTRA_APT_PACKAGES_83=
# EXTRA_APT_PACKAGES_84=
# EXTRA_APT_PACKAGES_85=

# Extra global Composer packages to install in the PHP image, space-separated
# (installed via `composer global require`). Applies to every PHP version.
# Example: EXTRA_COMPOSER_PACKAGES=laravel/installer deployer/deployer
EXTRA_COMPOSER_PACKAGES=

# Extra global Composer packages for one specific PHP version only (merged
# with EXTRA_COMPOSER_PACKAGES above). Suffix is the PHP version without the dot.
# EXTRA_COMPOSER_PACKAGES_82=
# EXTRA_COMPOSER_PACKAGES_83=
# EXTRA_COMPOSER_PACKAGES_84=
# EXTRA_COMPOSER_PACKAGES_85=

# Database engines to enable (comma-separated: mariadb, mysql, postgresql)
# Examples: "mariadb" (default), "mariadb,postgresql", "mariadb,mysql,postgresql"
DB_ENGINES=mariadb

# Maximum packet size for MariaDB/MySQL (e.g., 16M, 128M, 512M)
MYSQL_MAX_ALLOWED_PACKET=512M

# MariaDB settings
MARIADB_VERSION=10.11.9

# MySQL settings (only used if DB_ENGINES contains "mysql")
MYSQL_VERSION=8.0
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307

# PostgreSQL settings (only used if DB_ENGINES contains "postgresql")
POSTGRES_VERSION=16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# pgAdmin (dev only), also served at https://localhost when PostgreSQL is the
# only database engine (phpMyAdmin owns localhost otherwise)
PGADMIN_PORT=8081
