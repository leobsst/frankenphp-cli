# Copy to .env.local (not committed), or export these variables before `pnpm ios` / `pnpm android`.
# Never commit your own values: they identify your Apple team and your app.

# iOS signing team: Xcode › Settings › Accounts › your team, or developer.apple.com › Membership.
IOS_TEAM_ID=
# App identifier, unique to your team. Default: dev.frankenmanager.mobile
IOS_BUNDLE_ID=

# Android: identifier of the installed app. Default: dev.frankenmanager.mobile
ANDROID_APPLICATION_ID=
# Signing of the release build (the debug build uses the machine's debug key). Path relative to android/app, or
# absolute. Create a key: keytool -genkeypair -v -keystore frankenmanager.jks -alias fm \
#   -keyalg RSA -keysize 2048 -validity 10000
ANDROID_KEYSTORE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Version and build number (iOS and Android). Without a value: the last mobile-vX.Y.Z git tag (otherwise the
# version of package.json) and the git commit count.
APP_VERSION=
APP_BUILD=
