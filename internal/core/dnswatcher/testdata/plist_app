<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>dev.frankenmanager</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>dev.frankenmanager.dns-watcher</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/lib/frankenmanager/FrankenManager.app/Contents/MacOS/frankenmanager-agent</string>
		<string>--no-update-check</string>
		<string>_watch-dns-internal</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/me/Library/Application Support/frankenmanager &amp; &lt;co&gt;/.dns_watcher.log</string>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>WorkingDirectory</key>
	<string>/Users/me/Library/Application Support/frankenmanager &amp; &lt;co&gt;</string>
</dict>
</plist>
