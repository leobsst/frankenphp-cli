{
	http_port {$WEB_HTTP_PORT:80}
	https_port {$WEB_HTTPS_PORT:443}
}

app.test {
	tls /certs/app.test.pem /certs/app.test-key.pem
	reverse_proxy 127.0.0.1:8380 {
		header_up Host "app.test"
	}
	log {
		output file /var/log/caddy/app_access.log {
			roll_size 10mb
			roll_keep 5
			roll_keep_for 720h
		}
		format console
	}
}

