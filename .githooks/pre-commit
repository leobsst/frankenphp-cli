#!/usr/bin/env bash
# Pre-commit hook: lint the Go code changed since HEAD with the golangci-lint
# version of the CI (.golangci.yml). Enable it once with `make hooks`.
set -euo pipefail

GOLANGCI_LINT_VERSION=v2.15.0

# Nothing to lint without staged Go files
if [ -z "$(git diff --cached --name-only --diff-filter=ACMR -- '*.go' go.mod go.sum)" ]; then
  exit 0
fi

echo "golangci-lint ${GOLANGCI_LINT_VERSION} (code changed since HEAD)..."
if ! go run "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}" \
    run --new-from-rev=HEAD ./...; then
  echo ""
  echo "Commit aborted: fix the issues above (formatting: gofmt -w <file>), or commit with --no-verify."
  exit 1
fi
